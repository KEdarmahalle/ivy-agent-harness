# Model providers (set only the keys used by the configured routes)
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# API/runtime configuration overrides
AGENT_HARNESS_API_KEY=
AGENT_HARNESS_BIND_HOST=
AGENT_HARNESS_CONFIG=
AGENT_HARNESS_SECRET_STORE=
AGENT_HARNESS_SECRETS_BACKEND=

# Per-principal API keys referenced by auth.api_keys[].key_env in config.yaml
# Example: IVY_DEVELOPER_KEY=

# GitHub worker and webhook integration
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=
GITHUB_WEBHOOK_SECRET=

# Slack worker and webhook integration
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# Jira worker and webhook integration
JIRA_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# Optional Langfuse SDK configuration (used by Langfuse when enabled)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
